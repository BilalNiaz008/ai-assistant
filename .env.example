# Jarvis AI Assistant Configuration
# Copy this file to .env and fill in your values

# ====================
# User Configuration
# ====================
USER_NAME=Bilal
USER_TIMEZONE=America/New_York
USER_LOCATION=New York,US

# ====================
# OpenAI / Claude API
# ====================
# Choose one: OPENAI or ANTHROPIC
AI_PROVIDER=OPENAI

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic/Claude Configuration (alternative)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# ====================
# Weather API (OpenWeather)
# ====================
# Get your API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key-here
WEATHER_UNITS=metric

# ====================
# Gmail API Configuration
# ====================
# Follow setup guide in README.md to get these
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback

# ====================
# Spotify Configuration (Optional)
# ====================
# Get credentials from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/spotify-callback

# Default playlist or track URI to play on startup
SPOTIFY_DEFAULT_PLAYLIST=spotify:playlist:37i9dQZF1DXcBWIGoYBM5M

# When Jarvis starts Spotify via the Web API, set device volume (0–100). Default ~28 for background.
SPOTIFY_PLAYBACK_VOLUME=28
# Set to false to skip (e.g. if the API returns errors on your account)
SPOTIFY_SET_VOLUME_ON_PLAY=true

# Assistant voice loudness (separate from Spotify)
# Windows SAPI: 0–100 (default 100)
VOICE_SAPI_VOLUME=100
# OpenAI TTS MP3 on Windows (MediaPlayer): 0–100 → 0.0–1.0
VOICE_PLAYER_VOLUME=100
# ffplay linear gain for TTS MP3 (1 = normal; 1.45 ≈ louder; try 1.6–2.0 if still quiet)
VOICE_MP3_GAIN=1.45

# ====================
# Browser / Basecamp (optional)
# ====================
# Your Basecamp home or main project URL (copy from the browser address bar)
BASECAMP_URL=https://3.basecamp.com/YOUR_ACCOUNT_ID/
# Only if Chrome is not found automatically (Windows example):
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ====================
# Local Music Configuration
# ====================
# Path to local music file or folder (fallback if Spotify unavailable)
LOCAL_MUSIC_PATH=C:/Users/YourUser/Music/morning-playlist.mp3

# ====================
# Application Settings
# ====================
# Enable/disable features
ENABLE_WEATHER=true
ENABLE_EMAIL=true
ENABLE_MUSIC=true
ENABLE_AI_SUMMARY=true
ENABLE_DECISION_ENGINE=true

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true

# Server port (for OAuth callbacks)
SERVER_PORT=3000
